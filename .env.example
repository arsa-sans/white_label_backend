# White Label Backend — Environment Variables
# Copy to .env and fill in actual values before running

# ============================
# Server
# ============================
PORT=4000
NODE_ENV=development

# ============================
# Database (MySQL)
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whitelabel_dev
DB_USER=root
DB_PASS=your_mysql_password
DB_DIALECT=mysql

# ============================
# Redis
# ============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================
# RabbitMQ
# ============================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ============================
# JWT
# ============================
JWT_SECRET=replace_with_very_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_very_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# Dynamic QR Code (AES-256)
# Platform-level secret — NEVER expose to client or per-tenant config
# ============================
QR_AES_KEY=replace_with_32_byte_hex_key_64_chars_exactly_here_ok

# ============================
# Offline Gate HMAC
# ============================
GATE_HMAC_SECRET=replace_with_hmac_secret_for_offline_gate_validation

# ============================
# MinIO / S3 (file uploads: banners, assets)
# ============================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whitelabel
S3_REGION=us-east-1

# ============================
# Payment Gateways (Sandbox)
# ============================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# ============================
# Notification
# ============================
SENDGRID_API_KEY=SG.xxxx
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_API_TOKEN=xxxx

# ============================
# Frontend CORS Origin
# ============================
CORS_ORIGIN=http://localhost:3000
