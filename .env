# White Label Backend — Environment Variables
# Copy to .env and fill in actual values before running

# ============================
# Server
# ============================
PORT=4000
NODE_ENV=development

# ============================
# Database (MySQL)
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_whitelabel
DB_USER=root
DB_PASS=
DB_DIALECT=mysql

# ============================
# Redis
# ============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================
# RabbitMQ
# ============================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ============================
# JWT
# ============================
JWT_SECRET=268e0606d728cb007e56bea2e4f6778d1366bccb504103b78c5616b97d3db41774abfa168b7402428d5f9bca477af27d32c78b935a0cf6e2afbdb948161310e1
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=6d41a1fa48aeca26acad87877158dd76fabbb7dd0763bddab034ca71f9686886dc3cdc797e8f3ca8ddcdfa0911f0f2a16564a0086d1f4079872ca86fd1b5e18a24d9029f5f29a20a83f54506b82dc2fe4db6dbbc3b043d14ecd460a9b29315f8d8ba5d9736156dbd4b454a9917830018d031c2c6a0fc521062c2969fb361ac55
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# Dynamic QR Code (AES-256)
# Platform-level secret — NEVER expose to client or per-tenant config
# ============================
QR_AES_KEY=20847cccd727f767c51f3e29fad7c56f561373c81a374c50c15daf86f8670a989386da72cb1409c5a9395c031becaf193f611ceb7728b125d4371a6836f3cf53

# ============================
# Offline Gate HMAC
# ============================
GATE_HMAC_SECRET=2d02ba85fa9657839cd650bcc1a0399319297b1160cf8fc44cb75aa4460dc0b1921f9812d48364e8061981d8ca09bb5f09fcc6d81059a0576b7f4f13935911c9

# ============================
# MinIO / S3 (file uploads: banners, assets)
# ============================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=whitelabel
S3_REGION=us-east-1

# ============================
# Payment Gateways (Sandbox)
# ============================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# ============================
# Notification
# ============================
SENDGRID_API_KEY=SG.xxxx
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_API_TOKEN=xxxx

# ============================
# Frontend CORS Origin
# ============================
CORS_ORIGIN=http://localhost:3000
